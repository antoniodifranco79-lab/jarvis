# ---- Required ----
ANTHROPIC_API_KEY=

# ---- Brain ----
JARVIS_MODEL=claude-opus-5-5          # any current Claude model id
JARVIS_EFFORT=medium                  # low | medium | high | xhigh | max
JARVIS_USER_NAME=Sir                  # how Jarvis addresses you ("Signore", "Boss", your name...)
JARVIS_USER_FULL_NAME=                # optional: your full name, for context
JARVIS_LANGUAGE=auto                  # auto | it | en | ... (auto = mirror the user's language)
JARVIS_LOCATION=                      # e.g. "Milano, IT" - default for weather
JARVIS_TIMEZONE=                      # IANA tz, e.g. Europe/Rome (default: system)
JARVIS_AUTO_APPROVE=false             # true = run shell/app commands without confirmation (careful)
JARVIS_SHELL_ENABLED=true             # expose the run_shell tool
JARVIS_WEB_SEARCH=true                # Anthropic server-side web search tool
JARVIS_WEB_FETCH=true                 # Anthropic server-side web fetch tool
JARVIS_FALLBACKS=true                 # server-side refusal fallbacks (recommended)
JARVIS_SERVER_COMPACTION=false        # server-side context compaction for very long sessions
JARVIS_SESSION_TOKEN_BUDGET=120000    # start a fresh (summarised) session past this estimate
JARVIS_SESSION_IDLE_HOURS=6           # start a fresh session after this much silence

# ---- Voice ----
JARVIS_TTS_ENGINE=edge                # edge | elevenlabs | pyttsx3 | none
JARVIS_TTS_VOICE_EN=en-GB-RyanNeural  # the classic British Jarvis timbre
JARVIS_TTS_VOICE_IT=it-IT-DiegoNeural
JARVIS_TTS_RATE=+5%
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=
JARVIS_STT_MODEL=small                # faster-whisper size: tiny | base | small | medium | large-v3
JARVIS_WAKE_WORD=hey_jarvis           # openWakeWord built-in model
JARVIS_WAKE_THRESHOLD=0.5

# ---- HUD server ----
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# ---- Integrations (optional) ----
JARVIS_HOME_ASSISTANT_URL=            # e.g. http://homeassistant.local:8123
JARVIS_HOME_ASSISTANT_TOKEN=
JARVIS_NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.ansa.it/sito/notizie/topnews/topnews_rss.xml
